<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the API (Owner: Ravindu).
  WebDAV blocks PUT and DELETE requests, but many IIS installs lock the modules
  section, so deploy-api.ps1 turns WebDAV off for this site at server level instead.
  Source: API-04 and API-11 (sources/api-sources.md).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\SolarGrid.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
