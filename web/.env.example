# Copy this file to .env.local and fill in the values for your computer.
# .env.local is ignored by Git, so keys never reach the repository.

# Web API address. IIS: http://localhost:8080   Visual Studio / dotnet run: http://localhost:5080
VITE_API_URL=http://localhost:8080

# Google Maps JavaScript API key (optional). Without a key the maps use OpenStreetMap.
# Restrict the key in Google Cloud: website restrictions for http://localhost:5173/*,
# http://localhost:5174/* and http://localhost:8081/*, and the Maps JavaScript API only.
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps map ID (optional). Empty uses Google's DEMO_MAP_ID, which is fine for testing.
VITE_GOOGLE_MAPS_MAP_ID=

# Map service: leave empty to use Google Maps when a key is set; "osm" always uses OpenStreetMap.
VITE_MAPS_PROVIDER=
