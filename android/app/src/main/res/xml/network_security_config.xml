<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    network_security_config.xml
  Module:  Core
  Owner:   Ravindu
  Purpose: The Web API on this PC runs on plain HTTP, which Android blocks by
           default. Plain HTTP is allowed only for the development addresses:
           10.0.2.2 is the PC as seen from the emulator, and 127.0.0.1 is the
           test server used by the instrumented tests. Everything else, such as
           Google Maps, must use HTTPS.
           For a real phone, add the PC's IP address here.
  Source:  AND-08 (Android network security configuration).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
