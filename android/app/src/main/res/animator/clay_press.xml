<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    clay_press.xml
  Module:  Theme
  Owner:   Ravindu
  Purpose: Clay "squish": buttons shrink a little and sink while pressed.
  Source:  AND-02 (clay design system).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="0.95" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="0.95" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="translationZ" android:valueTo="-4dp" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="160" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="translationZ" android:valueTo="0dp" android:valueType="floatType" />
        </set>
    </item>
</selector>
