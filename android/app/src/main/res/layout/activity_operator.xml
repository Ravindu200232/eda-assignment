<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    activity_operator.xml
  Module:  Operator shell
  Owner:   Ravindu
  Purpose: The frame for Grid Operator screens: scanning, the bookings of the
           day, the battery bays and the account.
  Source:  AND-10 (Material bottom navigation).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/tab_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/nav_operator" />

</LinearLayout>
