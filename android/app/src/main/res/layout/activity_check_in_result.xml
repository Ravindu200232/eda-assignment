<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    activity_check_in_result.xml
  Module:  Operator Check-in
  Owner:   Ravindu
  Purpose: What the server said about a scanned code, the booking behind it,
           and the box where the operator writes the energy that was really
           delivered before finishing the transfer.
  Source:  AND-02 (clay design system).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_s">

        <ImageButton
            android:id="@+id/result_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/operator_booking_title"
            android:textAppearance="@style/TextAppearance.SolarGrid.CardTitle" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- While the server is checking the code -->
        <LinearLayout
            android:id="@+id/state_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/checkin_checking"
                android:textAppearance="@style/TextAppearance.SolarGrid.Muted" />
        </LinearLayout>

        <!-- The code could not be checked at all -->
        <LinearLayout
            android:id="@+id/state_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/icon_orb_size"
                android:layout_height="@dimen/icon_orb_size"
                android:background="@drawable/bg_orb_pink">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_triangle_alert"
                    app:tint="@color/on_accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.SolarGrid.Body"
                tools:text="Cannot reach the API." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_retry"
                app:icon="@drawable/ic_refresh_cw" />
        </LinearLayout>

        <!-- What the server said about the booking -->
        <ScrollView
            android:id="@+id/state_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/screen_padding">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/result_orb"
                            android:layout_width="@dimen/icon_orb_size"
                            android:layout_height="@dimen/icon_orb_size"
                            android:background="@drawable/bg_orb_emerald">

                            <ImageView
                                android:id="@+id/result_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_circle_check"
                                app:tint="@color/on_accent" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/result_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SolarGrid.CardTitle"
                                tools:text="Ready to complete" />

                            <TextView
                                android:id="@+id/result_message"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:textAppearance="@style/TextAppearance.SolarGrid.Body"
                                tools:text="The booking is approved for this station." />

                            <TextView
                                android:id="@+id/result_window"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:textAppearance="@style/TextAppearance.SolarGrid.Muted"
                                tools:text="Check-in is open from 08:00 to 10:00" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/booking_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/booking_reference"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.SolarGrid.CardTitle"
                                tools:text="RSV-260918-AB12C" />

                            <TextView
                                android:id="@+id/booking_status"
                                style="@style/Widget.SolarGrid.StatusChip"
                                android:backgroundTint="@color/chip_success_bg"
                                android:textColor="@color/chip_success_text"
                                tools:text="Approved" />
                        </LinearLayout>

                        <include
                            android:id="@+id/booking_prosumer_row"
                            layout="@layout/view_detail_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s" />

                        <include
                            android:id="@+id/booking_station_row"
                            layout="@layout/view_detail_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/booking_slot_row"
                            layout="@layout/view_detail_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/booking_energy_row"
                            layout="@layout/view_detail_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/booking_trade_row"
                            layout="@layout/view_detail_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/booking_call"
                            style="@style/Widget.SolarGrid.Button.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/checkin_call_prosumer"
                            app:icon="@drawable/ic_phone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Only shown while the API says the transfer may be finished -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/complete_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/delivered_box"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/operator_delivered_kwh"
                            app:startIconDrawable="@drawable/ic_zap">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/delivered_kwh"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/complete_action"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:text="@string/operator_complete_action"
                            app:icon="@drawable/ic_circle_check" />

                        <ProgressBar
                            android:id="@+id/complete_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/accent"
                            android:visibility="invisible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Shown after the transfer has been recorded -->
                <LinearLayout
                    android:id="@+id/done_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/done_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/operator_next_booking"
                        app:icon="@drawable/ic_scan_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/done_close"
                        style="@style/Widget.SolarGrid.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/action_close" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
