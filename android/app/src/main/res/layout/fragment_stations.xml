<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    fragment_stations.xml
  Module:  Stations
  Owner:   Nimthara
  Purpose: The Map tab: nearby stations on a Google map, or as a list with a
           search box. Tapping a station opens a card with its bays, hours and
           distance.
  Source:  AND-02 (clay design system), AND-29 (Google Maps SDK for Android).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stations_eyebrow"
            android:textAppearance="@style/TextAppearance.SolarGrid.Eyebrow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stations_title"
                android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/stations_view_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedButton="@+id/stations_show_map"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stations_show_map"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/stations_show_map"
                    app:icon="@drawable/ic_map"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stations_show_list"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/stations_show_list"
                    app:icon="@drawable/ic_list"
                    app:iconPadding="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Where the map started, a missing key, or an offline list. -->
        <TextView
            android:id="@+id/stations_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_well"
            android:drawablePadding="@dimen/space_s"
            android:gravity="center_vertical"
            android:padding="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.SolarGrid.Muted"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_info"
            app:drawableTint="@color/info"
            tools:text="Showing stations around Colombo."
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/stations_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="invisible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The Google map; filled by the fragment when a Maps key is set. -->
        <FrameLayout
            android:id="@+id/stations_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- The list, with a search box. -->
        <LinearLayout
            android:id="@+id/stations_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/stations_search_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding"
                android:hint="@string/stations_search"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/stations_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stations_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/screen_padding"
                tools:listitem="@layout/item_station" />
        </LinearLayout>

        <!-- The card of the station tapped on the map. -->
        <!-- Solid, so the map under it does not show through the words. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/station_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="@dimen/screen_padding"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_solid"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/station_card_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.SolarGrid.CardTitle"
                        tools:text="SLIIT Malabe Campus Microgrid" />

                    <ImageButton
                        android:id="@+id/station_card_close"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_close"
                        android:src="@drawable/ic_x"
                        app:tint="@color/muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/station_card_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SolarGrid.Muted"
                    tools:text="New Kandy Road, Malabe · 1.2 km away" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/station_card_bays"
                        style="@style/Widget.SolarGrid.StatusChip"
                        tools:text="9 of 12 bays free" />

                    <TextView
                        android:id="@+id/station_card_hours"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:textAppearance="@style/TextAppearance.SolarGrid.Body"
                        tools:text="Today: open all day" />
                </LinearLayout>

                <TextView
                    android:id="@+id/station_card_energy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.SolarGrid.Muted"
                    tools:text="Up to 50 kWh per booking" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/station_card_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/stations_see_slots"
                    app:icon="@drawable/ic_calendar_days" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
