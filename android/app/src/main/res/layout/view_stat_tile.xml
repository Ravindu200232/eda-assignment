<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    view_stat_tile.xml
  Module:  Dashboards
  Owner:   Malith
  Purpose: One number on the prosumer home screen: a coloured orb with an icon,
           the number itself and what it counts.
  Source:  AND-02 (clay design system).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/stat_orb"
            android:layout_width="@dimen/icon_orb_size"
            android:layout_height="@dimen/icon_orb_size"
            android:background="@drawable/bg_orb_violet">

            <ImageView
                android:id="@+id/stat_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/on_accent"
                tools:src="@drawable/ic_clock" />
        </FrameLayout>

        <TextView
            android:id="@+id/stat_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.SolarGrid.Number"
            android:textColor="@color/ink"
            tools:text="3" />

        <TextView
            android:id="@+id/stat_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SolarGrid.Muted"
            tools:text="Waiting for approval" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
