<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    fragment_bookings.xml
  Module:  Energy Reservations
  Owner:   Hamnad
  Purpose: The Bookings tab: current, waiting and past bookings in three tabs,
           with a search box, filters for status, station and dates, and the
           button that starts a new booking.
  Source:  AND-02 (clay design system), AND-33 (Material tabs and date range picker).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bookings_eyebrow"
            android:textAppearance="@style/TextAppearance.SolarGrid.Eyebrow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bookings_title"
                android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookings_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookings_new"
                app:icon="@drawable/ic_calendar_plus" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/bookings_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:background="@color/transparent"
        app:tabIndicatorColor="@color/accent"
        app:tabSelectedTextColor="@color/accent"
        app:tabTextColor="@color/muted">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bookings_tab_current" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bookings_tab_pending" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bookings_tab_history" />
    </com.google.android.material.tabs.TabLayout>

    <!-- clipToPadding off, so the filter row can reach the screen edges. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_padding">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/bookings_search_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bookings_search"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bookings_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- The row reaches the screen edges, so chips scroll out of sight
             instead of being cut at the margin. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding_negative"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginEnd="@dimen/screen_padding_negative"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/bookings_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/bookings_filter_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="@string/filter_status_any"
                    app:chipIcon="@drawable/ic_funnel"
                    app:chipIconTint="@color/accent"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/bookings_filter_station"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="@string/filter_station_any"
                    app:chipIcon="@drawable/ic_map_pin"
                    app:chipIconTint="@color/accent"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/bookings_filter_dates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="@string/filter_dates_any"
                    app:chipIcon="@drawable/ic_calendar_days"
                    app:chipIconTint="@color/accent"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/bookings_filter_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="@string/filter_clear"
                    android:visibility="gone"
                    app:chipIcon="@drawable/ic_x"
                    app:chipIconTint="@color/danger"
                    app:chipIconVisible="true" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/bookings_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_well"
            android:drawablePadding="@dimen/space_s"
            android:gravity="center_vertical"
            android:padding="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.SolarGrid.Body"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_wifi_off"
            app:drawableTint="@color/warning"
            tools:text="Cannot reach the API."
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/bookings_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bookings_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/screen_padding"
                tools:listitem="@layout/item_booking_summary" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/bookings_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:textAppearance="@style/TextAppearance.SolarGrid.Muted"
            android:visibility="gone"
            tools:text="No current bookings."
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
