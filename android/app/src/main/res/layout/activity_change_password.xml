<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    activity_change_password.xml
  Module:  Prosumer Accounts
  Owner:   Malith
  Purpose: Change the password: the current one, the new one and the new one
           again. Used by prosumers and Grid Operators alike.
  Source:  AND-02 (clay design system), AND-05 (Material text fields).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_s">

        <ImageButton
            android:id="@+id/password_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/account_change_password"
            android:textAppearance="@style/TextAppearance.SolarGrid.CardTitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_intro"
                        android:textAppearance="@style/TextAppearance.SolarGrid.Muted" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password_current_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:hint="@string/account_current_password"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password_current"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password_new_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:hint="@string/account_new_password"
                        app:endIconMode="password_toggle"
                        app:helperText="@string/password_rule"
                        app:startIconDrawable="@drawable/ic_key_round">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password_new"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="newPassword"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password_confirm_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:hint="@string/register_confirm_password"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_key_round">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password_confirm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="newPassword"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/password_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:background="@drawable/bg_well"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:padding="@dimen/space_m"
                        android:textAppearance="@style/TextAppearance.SolarGrid.Body"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/password_save"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:text="@string/password_save"
                        app:icon="@drawable/ic_lock" />

                    <ProgressBar
                        android:id="@+id/password_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/accent"
                        android:visibility="invisible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
