<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    dialog_reason.xml
  Module:  Energy Reservations
  Owner:   Hamnad
  Purpose: The inside of the cancel dialog: what cancelling means and an
           optional reason (at most 200 characters, as the API allows).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/reason_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/booking_cancel_message"
        android:textAppearance="@style/TextAppearance.SolarGrid.Body" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/reason_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:hint="@string/booking_cancel_reason"
        app:counterEnabled="true"
        app:counterMaxLength="200"
        app:helperText="@string/optional">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="200"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
