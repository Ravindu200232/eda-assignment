<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    bg_button_primary.xml
  Module:  Theme
  Owner:   Ravindu
  Purpose: Primary button: violet gradient pill; faded when disabled.
  Source:  AND-02 (clay design system).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_control" />
            <solid android:color="@color/accent_light" />
        </shape>
    </item>
    <item>
        <ripple android:color="#33FFFFFF">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_control" />
                    <gradient android:angle="315" android:endColor="@color/accent" android:startColor="@color/accent_light" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
