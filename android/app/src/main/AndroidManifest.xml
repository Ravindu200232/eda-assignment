<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    AndroidManifest.xml
  Module:  Core
  Owner:   Ravindu
  Purpose: Permissions the app asks for, the application settings and every
           screen. Each member adds their own activities here.
  Source:  AND-01 (Android project structure), AND-08 (network security config).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app only talks to the Web API and shows maps. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- From Android 17 an app needs this to reach a server on the local
         network, such as the API on the development computer (10.0.2.2). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Grid Operators scan booking QR codes. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Nimthara: the map starts where the prosumer is, if they allow it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SolarGridApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SolarGrid">

        <!-- Nimthara: the Google Maps key comes from local.properties, never from Git. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <!-- Ravindu: start-up, sign in and operator mode -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SolarGrid.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.prosumer.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.operator.CheckInResultActivity"
            android:exported="false" />

        <!-- Malith: sign-up, profile and password -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.RegisteredActivity"
            android:exported="false" />

        <activity
            android:name=".ui.prosumer.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.common.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Nimthara: the page of one station -->
        <activity
            android:name=".ui.map.StationDetailsActivity"
            android:exported="false" />

    </application>

</manifest>
